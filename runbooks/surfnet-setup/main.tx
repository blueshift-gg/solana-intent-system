addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "install_pull" "svm::setup_surfnet" {
    description = "Install the Pull program at its canonical address via direct account write"
    rpc_api_url = input.rpc_api_url

    deploy_program {
        program_id = "PULLrgDYqK1yFKVTSbWieX3ARP7U2XUyrjxWXqKgVzA"
        binary_path = "target/deploy/pull_program.so"
    }
}
